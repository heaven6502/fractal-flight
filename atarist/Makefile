# Atari ST ports (1040ST, 68000, no blitter).  Toolchain: m68k-atari-mintelf-gcc (tools/mintelf) + vasm + vlink (tools/bin).
# Use build.sh (puts the tools on PATH) or: export PATH=$PWD/tools/bin:$PWD/tools/mintelf/mingw64/bin:$PATH
#   make              out/flight.prg
CC    = m68k-atari-mintelf-gcc
VASM  = vasmm68k_mot
OBJ   = obj

# make FPS=0 builds the final programs without the picture rate number
FPS ?= 1
CCFLAGS = -DSHOW_FPS=$(FPS) -m68000 -O2 -nostdlib -nostartfiles -fomit-frame-pointer -fno-tree-loop-distribute-patterns -ffunction-sections -fdata-sections \
          -Wall -Wextra -Wno-unused-function -DPG_ST -DPLOT_PLANAR -DFLIGHT_ASM -DF_ROWREP=1 -Isrc -Isrc/inc
LDFLAGS = -nostdlib -nostartfiles -Wl,-e,_start,--gc-sections
VFLAGS  = -quiet -Felf -m68000 -DROWREP=1

c_flight   = flight_st flight_core flight_data st_lib st_sys st_scroll font_antic st_logo logo_data st_mod st_sndh st_descent
c_flightbd = flight_st_backdrop flight_core flight_data sky_data st_lib st_sys st_scroll font_antic st_logo logo_data st_mod st_sndh      # flightbd = the flight with the background image (8.3 name for the GEMDOS)
asm_flight = st_crt st_finish st_vtab flight_line flight_edge st_music st_mus_f st_sndh_asm

UPX = tools/bin/upx.exe
all: out/flightk.prg out/flight.prg out/flightbd.prg out/flightz.prg out/flightz2.prg out/flightz3.prg out/flightuw.prg

define PRG
out/$(1).prg: $(addprefix $(OBJ)/,$(addsuffix .o,$(2))) $(addprefix $(OBJ)/,$(addsuffix .o,$(3)))
	$(CC) $(LDFLAGS) -s -o $$@ $$^ -lgcc
endef
$(eval $(call PRG,flight,$(c_flight),$(asm_flight)))
$(eval $(call PRG,flightbd,$(c_flightbd),$(asm_flight)))
# make pack: self depacking versions (UPX, atari/tos): out/flight_packed.prg ...
.PRECIOUS: out/%_packed.prg
pack: out/flight_packed.prg
out/%_packed.prg: out/%.prg
	$(UPX) --best -f -o $@ $<

$(OBJ)/%.o: src/%.c
	$(CC) $(CCFLAGS) -MMD -MP -c -o $@ $<
$(OBJ)/st_music.o: src/st_music.s music/demo.ymr
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJ)/st_mus_f.o: src/st_mus_f.s music/flight.sndh
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJ)/st_hackl.o: src/st_hackl.s
	$(VASM) $(VFLAGS) -devpac -o $@ $<
$(OBJ)/st_mod_data.o: src/st_mod_data.s music/mod/DESERTD2.MOD
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJ)/%.o: src/%.s
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJ)/%.o: src/%.asm
	$(VASM) $(VFLAGS) -o $@ $<

# the SNDH tunes are not in the repository (other people's music): without them a stub is made and the programs play the demo .ymr stream instead
music/flight.sndh:
	test -f $@ || printf 'STUB' > $@        # (never overwrite a real tune, not even with make -B)

# flightk: the same flight with the unrolled kernels for the small pieces of the fractal line (flight_line_k.asm, generated by tools/mkline_k.py; the picture is bit for bit the same as flight)
asm_flightk = st_crt st_finish st_vtab flight_line_k flight_edge st_music st_mus_f st_sndh_asm
out/flightk.prg: $(addprefix $(OBJ)/,$(addsuffix .o,$(c_flight))) $(addprefix $(OBJ)/,$(addsuffix .o,$(asm_flightk)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc

# flightz: the depth band variant of the flight (5 ridge planes, one dither per cell row band); its own object directory (the core is built with -DFLIGHT_BANDS)
OBJZ = objz
c_flightz   = flight_st_z flight_core flight_data sky_data st_lib st_sys st_scroll font_antic st_logo logo_data st_mod st_sndh
asm_flightz = st_crt st_finish_z st_vtab flight_line_z flight_edge st_music st_mus_f st_sndh_asm
out/flightz.prg: $(addprefix $(OBJZ)/,$(addsuffix .o,$(c_flightz))) $(addprefix $(OBJZ)/,$(addsuffix .o,$(asm_flightz)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc
asm_flightz2 = st_crt st_finish_z2 st_vtab flight_line_z flight_edge st_music st_mus_f st_sndh_asm
out/flightz2.prg: $(addprefix $(OBJZ)/,$(addsuffix .o,$(c_flightz))) $(addprefix $(OBJZ)/,$(addsuffix .o,$(asm_flightz2)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc
asm_flightz3 = st_crt st_finish_z3 st_vtab flight_line_z flight_edge st_music st_mus_f st_sndh_asm
out/flightz3.prg: $(addprefix $(OBJZ)/,$(addsuffix .o,$(c_flightz))) $(addprefix $(OBJZ)/,$(addsuffix .o,$(asm_flightz3)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc
$(OBJZ)/%.o: src/%.c
	$(CC) $(CCFLAGS) -DFLIGHT_BANDS -MMD -MP -c -o $@ $<
$(OBJZ)/st_hackl.o: src/st_hackl.s
	$(VASM) $(VFLAGS) -devpac -o $@ $<
$(OBJZ)/st_mod_data.o: src/st_mod_data.s music/mod/DESERTD2.MOD
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJZ)/%.o: src/%.s
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJZ)/%.o: src/%.asm
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJZ)/st_mus_f.o: src/st_mus_f.s music/flight.sndh
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJZ)/st_music.o: src/st_music.s music/demo.ymr
	$(VASM) $(VFLAGS) -o $@ $<

-include $(OBJ)/*.d $(OBJZ)/*.d
clean:
	rm -f $(OBJ)/*.o $(OBJ)/*.d out/*.prg
.PHONY: all clean

# flightuw: the underwater version (sea colours, wobble of the vertices, strip wave); its own object directory (flight_st.c with -DUNDERWATER, st_vtab.s with UW)
OBJUW = objuw
asm_flightuw = st_crt st_finish_uw st_vtab flight_line flight_edge st_music st_mus_f st_sndh_asm       # no MOD (st_mod_data, st_hackl) and no STE music: the 420 KB arena is gone
out/flightuw.prg: $(addprefix $(OBJUW)/,$(addsuffix .o,$(c_flight))) $(addprefix $(OBJUW)/,$(addsuffix .o,$(asm_flightuw)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc
$(OBJUW)/%.o: src/%.c
	$(CC) $(CCFLAGS) -DUNDERWATER -MMD -MP -c -o $@ $<
$(OBJUW)/st_hackl.o: src/st_hackl.s
	$(VASM) $(VFLAGS) -devpac -o $@ $<
$(OBJUW)/st_mod_data.o: src/st_mod_data.s music/mod/DESERTD2.MOD
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJUW)/st_vtab.o: src/st_vtab.s
	$(VASM) $(VFLAGS) -DUW=1 -o $@ $<
$(OBJUW)/st_mus_f.o: src/st_mus_f.s music/flight.sndh
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJUW)/%.o: src/%.s
	$(VASM) $(VFLAGS) -o $@ $<
$(OBJUW)/%.o: src/%.asm
	$(VASM) $(VFLAGS) -o $@ $<

# flight320: the flight at 320 x 180 single pixels (flight320_st.c, line routine generated by tools/mkline320_st.py, CPU clear / drip in st_f320.s)
c_f320   = flight320_st planetgen palgen flight_core_f3 flight_data st_lib st_sys st_scroll font_antic st_logo logo_data st_mod st_sndh st_descent
asm_f320 = st_crt st_f320 st_vtab flight_line flight_line320_st flight_edge st_music st_mus_f st_sndh_asm
$(OBJ)/flight_core_f3.o: src/flight_core.c
	$(CC) $(CCFLAGS) -DFLIGHT320 -DF3_ASM -c -o $@ $<
out/flight320.prg: $(addprefix $(OBJ)/,$(addsuffix .o,$(c_f320))) $(addprefix $(OBJ)/,$(addsuffix .o,$(asm_f320)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc

# f320bk: flight320 with the bunkers (little houses on the valley floors, drawn by the CPU after the drip; the edge loop runs in C so that the vertices can be looked at)
c_f320bk = flight320_st_bk planetgen palgen flight_core_f3_bk flight_data st_lib st_sys st_scroll font_antic st_logo logo_data st_mod st_sndh st_descent
$(OBJ)/flight_core_f3_bk.o: src/flight_core.c
	$(CC) $(CCFLAGS) -DFLIGHT320 -DF3_ASM -DBUNKERS -c -o $@ $<
$(OBJ)/flight320_st_bk.o: src/flight320_st.c
	$(CC) $(CCFLAGS) -DBUNKERS -c -o $@ $<
out/f320bk.prg: $(addprefix $(OBJ)/,$(addsuffix .o,$(c_f320bk))) $(addprefix $(OBJ)/,$(addsuffix .o,$(asm_f320)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc

# f320lz: f320bk with the green laser (the enemy guns = the houses shoot at the player) and more houses
c_f320lz = flight320_st_lz planetgen palgen flight_core_f3_lz flight_data st_lib st_sys st_scroll font_antic st_logo logo_data st_mod st_sndh st_descent
$(OBJ)/flight_core_f3_lz.o: src/flight_core.c
	$(CC) $(CCFLAGS) -DFLIGHT320 -DF3_ASM -DBUNKERS -DLASER -c -o $@ $<
$(OBJ)/flight320_st_lz.o: src/flight320_st.c
	$(CC) $(CCFLAGS) -DBUNKERS -DLASER -c -o $@ $<
out/f320lz.prg: $(addprefix $(OBJ)/,$(addsuffix .o,$(c_f320lz))) $(addprefix $(OBJ)/,$(addsuffix .o,$(asm_f320)))
	$(CC) $(LDFLAGS) -s -o $@ $^ -lgcc
